{
  "name": "star-map-studio",
  "description": "Browser-only A4 star map generator with local astronomy and image exports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameydeshpande30/Start-Map-Studio.git"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --ignore-path ../.prettierignore --write ..",
    "format:check": "prettier --ignore-path ../.prettierignore --check .."
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^1.51.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
